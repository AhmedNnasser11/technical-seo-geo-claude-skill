{
  "schema_version": "1.0",
  "default_mode": "READ_ONLY",
  "tiers": {
    "READ_ONLY": {"write": false, "runtime": false, "network": "approved_sources_only"},
    "AUTO_FIX_SAFE": {"write": true, "runtime": false, "conditions": ["localized", "reversible", "deterministic", "no_business_semantics_change", "validation_passes"]},

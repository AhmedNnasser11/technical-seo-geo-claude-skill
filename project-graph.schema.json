{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technical SEO GEO Project Graph",
  "type": "object",
  "required": ["schema_version", "project", "nodes", "edges"],
  "properties": {
    "schema_version": {"type": "string"},
    "project": {
      "type": "object",
      "required": ["root", "description"],
      "properties": {
        "root": {"type": "string"},
        "description": {"type": "string"},
        "framework": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relation"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "relation": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "path", "description", "retrieval_hint", "status"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "path": {"type": "string"},
        "description": {"type": "string"},
        "retrieval_hint": {"type": "string"},
        "status": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "content_hash": {"type": "string"},
        "last_scanned": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technical SEO GEO Source Graph",
  "type": "object",
  "required": ["schema_version", "nodes", "edges"],
  "properties": {
    "schema_version": {"type": "string"},
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relation"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "relation": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "url", "description", "retrieval_hint", "authority", "freshness"],
      "properties": {
        "id": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "retrieval_hint": {"type": "string"},
        "authority": {"type": "string"},
        "scope": {"type": "array", "items": {"type": "string"}},
        "version": {"type": "string"},
        "updated_at": {"type": "string"},
        "last_checked": {"type": "string"},
        "content_hash": {"type": "string"},
        "freshness": {"type": "string"},
        "conclusions": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string"}
      }
    }
  }
}
